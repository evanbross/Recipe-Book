# PostgreSQL — provide either DATABASE_URL directly, or the individual POSTGRES_* vars
#DATABASE_URL=postgresql://user:password@localhost:5432/recipedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recipedb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=prefer

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=recipe-images
MINIO_PUBLIC_URL=http://localhost:9000/recipe-images

# App
SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173

# Tampermonkey capture listener (separate port from the main API)
CAPTURE_LISTENER_ENABLED=true
CAPTURE_LISTENER_HOST=127.0.0.1
CAPTURE_LISTENER_PORT=8001

# Caddy reverse proxy — registers this app as http://<CADDY_APP_NAME>.localhost
CADDY_ADMIN_URL=http://localhost:2019
CADDY_APP_NAME=recipe-app
CADDY_API_PORT=8088
CADDY_FRONTEND_PORT=5173

# Gmail / email scanning
# Place your Google Cloud Console OAuth2 Desktop credentials at:
#   backend/credentials/client_secret.json
# The token is auto-created at backend/credentials/gmail_token.json after first auth.
# Register this exact URI in Google Cloud Console → OAuth → Authorized redirect URIs:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088/email/auth/callback
EMAIL_SCAN_LABEL=Cooking
EMAIL_SCAN_INBOX_LOOKBACK_DAYS=30
